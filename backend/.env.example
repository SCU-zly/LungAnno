# LungAnno 后端配置示例——复制为 .env 后按环境修改（.env 不入库）
# 生产部署务必修改 DATABASE_URL 与 JWT_SECRET！

DATABASE_URL=postgresql://ctanno:ctanno@localhost:5432/ctanno
REDIS_URL=redis://localhost:6379
JWT_SECRET=please-change-me-to-a-long-random-string
STORAGE_ROOT=/data/ct-storage

# 检测模型：dlcsd（默认）/ deeplung（自备资产）/ monai_bundle
MODEL_VARIANT=dlcsd
# DLCSD 也复用此 bundle 的后处理配置
MODEL_BUNDLE_ROOT=~/.cache/monai
DLCSD_MODEL_PATH=~/.cache/dlcsd-md/DLCSD-mD.pt
MODEL_CUDA_DEVICE=cuda:0
DETECTION_TOP_K=0

# DeepLung 推理（仅 MODEL_VARIANT=deeplung；镜像/代码/权重均为内部资产，不公开发布）
DEEPLUNG_IMAGE=your-internal-deeplung-image
DEEPLUNG_CODE_DIR=/path/to/internal/ProcByModel
DEEPLUNG_RUNNER_DIR=/path/to/repo/deploy/deeplung
DEEPLUNG_CKPT=/deeplung/ProcByModel/ckpts/your-weights.ckpt
DEEPLUNG_GPU=auto
# DeepLung 候选过滤（logit 空间；默认 3/10 为模型原行为，调低提高召回、候选变多）
DEEPLUNG_LOGIT_THRESH=3
DEEPLUNG_MAX_NODES=10

# HTJ2K 流媒体编码（预处理时自动产出；缺失时前端回退 NIfTI 整卷）
HTJ2K_ENABLED=true
HTJ2K_QSTEP=8e-05
# htj2k 成功后是否保留未压缩 .nii（非 gzip 客户端回退用）；大批量摄入设 false 省 ~120M/例
KEEP_PLAIN_NII=true
# raw 目录为 symlink 农场时，DeepLung 容器内需同路径只读挂载 symlink 目标根；copy 模式留空
DEEPLUNG_RAW_MOUNT_ROOT=

# 共享存储和 GPU 上保持任务串行
ARQ_MAX_JOBS=1
